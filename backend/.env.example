# Copy to .env. Never commit real secrets.
STYLEIQ_ALLOWED_ORIGINS=http://localhost:3000
STYLEIQ_MAX_UPLOAD_MB=10
STYLEIQ_MAX_IMAGE_PIXELS=25000000
STYLEIQ_JOB_TTL_SECONDS=900
STYLEIQ_WEIGHTS_DIR=./weights
STYLEIQ_DEVICE=auto
# Set true in GPU deployment to fail startup/health checks when CUDA is unavailable.
STYLEIQ_REQUIRE_CUDA=false
